{
  "name": "epulet-lca",
  "productName": "Épület-LCA",
  "version": "1.0.0",
  "description": "Épület életciklus-elemző (LCA) – ÖKOBAUDAT-alapú CO₂-számítás",
  "author": "Hegyi Domonkos",
  "license": "UNLICENSED",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win --publish never",
    "release": "electron-builder --win --publish always"
  },
  "dependencies": {
    "electron-updater": "^6.3.9"
  },
  "devDependencies": {
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "hu.hegyidomonkos.epuletlca",
    "productName": "Épület-LCA",
    "executableName": "Epulet-LCA",
    "artifactName": "Epulet-LCA-Setup-${version}.${ext}",
    "directories": { "output": "dist", "buildResources": "build" },
    "files": ["main.js", "preload.js", "offline.html", "config.json", "build/icon.png"],
    "win": { "target": [{ "target": "nsis", "arch": ["x64"] }], "icon": "build/icon.png" },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Épület-LCA",
      "language": "1038"
    },
    "publish": [{ "provider": "github", "owner": "Domos2002", "repo": "epulet-lca", "releaseType": "release" }]
  }
}
